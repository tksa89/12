// ═══════════════════════════════════════════════════════════
//  2) التهيئة والمقاييس التكيّفية
// ═══════════════════════════════════════════════════════════
int _tfSec = int(math.max(nz(timeframe.in_seconds(timeframe.period), 3600), 1))
// اختيار أعماق الكشف حسب مجموعة الفريم (حدود قاطعة بلا تداخل ولا فجوة):
//   دقيقة: ≤ 15m (900s) — صغيرة: 30m..1h (≤ 3600s) — متوسطة: 2h..6h (≤ 21600s)
//   كبيرة: 8h..1D (≤ 86400s) — ضخمة: > 1D (2D,3D,W...). كلها فيبوناتشي.
// تُحسب مرّة (simple int) لتوافق شرط ta.pivot*.
bool _tfXSmall = _tfSec <= 900
bool _tfSmall  = _tfSec > 900   and _tfSec <= 3600
bool _tfMed    = _tfSec > 3600  and _tfSec <= 21600
bool _tfLarge  = _tfSec > 21600 and _tfSec <= 86400
bool _tfHuge   = _tfSec > 86400

// عدد الطبقات النشطة يقلّ مع كبر الفريم: ≤6h → 4 طبقات، 8h..1D → 3 (بلا XL)،
// >1D → طبقتان (بلا L و XL). مربوطة بخياري النماذج الصغيرة/الكبيرة.
// تشديد عبر العُمق (الفريمات الصغيرة ≤ 1h): إسقاط الطبقة الأضحل S (عمق 13) حيث
// الضوضاء أعلى، فتبدأ نماذج هذه الفريمات من عمق 21 (M) وما فوق. بقية الفريمات كما هي.
bool activeS  = i_SmallPats and not (_tfXSmall or _tfSmall)
bool activeM  = i_SmallPats
bool activeL  = i_BigPats and not _tfHuge
bool activeXL = i_BigPats and not _tfLarge and not _tfHuge

int KL_S_S  = _tfXSmall ? KLS_XS_S  : _tfSmall ? KLS_SM_S  : _tfMed ? KLS_MD_S  : _tfLarge ? KLS_LG_S  : KLS_HG_S
int KL_M_S  = _tfXSmall ? KLS_XS_M  : _tfSmall ? KLS_SM_M  : _tfMed ? KLS_MD_M  : _tfLarge ? KLS_LG_M  : KLS_HG_M
int KL_L_S  = _tfXSmall ? KLS_XS_L  : _tfSmall ? KLS_SM_L  : _tfMed ? KLS_MD_L  : _tfLarge ? KLS_LG_L  : KLS_HG_L
int KL_XL_S = _tfXSmall ? KLS_XS_XL : _tfSmall ? KLS_SM_XL : _tfMed ? KLS_MD_XL : _tfLarge ? KLS_LG_XL : KLS_HG_XL

// أقصى امتداد زمني للنموذج ثابت تقريباً عبر كل الفريمات: ~500 يوم.
// SCAN_SPAN بالشموع = الهدف الزمني ÷ زمن الشمعة، مقيّداً بين 90 و1200
// (السقف 1200 يحمي max_bars_back=1500 والفريمات الصغيرة؛ الأرضية 90 تُبقي
//  مجالاً كافياً لبناء XABCD على الفريمات الضخمة). يبقى simple int لحدود الحلقات.
const int SPAN_TARGET_SEC = 43200000
int SCAN_SPAN   = int(math.max(90.0, math.min(1200.0, math.round(float(SPAN_TARGET_SEC) / float(_tfSec)))))
int MAX_CD_BARS = SCAN_SPAN - 1

// ★ تعديل اعتماد النسبة وتجريدها من الـ ATR تماماً
float _minXAeff = XA_MIN_PCT_ABS

int g_msPerBar = int(math.max(nz(timeframe.in_seconds(timeframe.period), 60), 60)) * 1000
var array<int> g_update = array.new<int>(1, 0)
var array<bool> patFlag = array.new<bool>(2, false)

