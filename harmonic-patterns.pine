//  1) الأساس الرياضي
// ═══════════════════════════════════════════════════════════
const float TOL = 0.07
// عتبة التداخل البنيوي: نموذجان يتشابكان بنيوياً فقط إذا تجاوز تداخل مستطيليهما
// المحيطين هذه النسبة من مساحة الأصغر. عالية (شرط حذر) كي لا تُحذف نماذج متجاورة
// مشروعة — تُطبَّق فقط بين نماذج نفس الحالة فلا تمسّ الاستباقي.
const float STRUCT_OV_MIN = 0.70
// عتبة الاحتواء الحجمي: إذا كانت مساحة النموذج الأكبر ÷ الأصغر تتجاوز هذه القيمة،
// فهذا "نموذج كبير بداخله أصغر" (مستويات XABCD متباعدة) — يُسمح بتراكمهما ولا
// يُطبَّق منع التشابك البنيوي، لأنهما يكمّلان بعضهما لا يكرّرانه.
const float STRUCT_CONTAIN_MIN = 2.5

const float C_LO  = 0.500
const float C_HI  = 0.886
const float SC_LO = 1.130
const float SC_HI = 1.618
const float TGT1_STD   = 0.382
const float TGT2_STD   = 0.618
const float TGT1_SHARK = 0.500
const float TGT2_SHARK = 0.618

const float ABCD_CD_MIN  = 0.50
const float ABCD_CD_MAX  = 3.60
const float B_MIN_RETR   = 0.200
const float B_MAX_RETR   = 0.980
const float LEG_MIN_FRAC = 0.10
const float ABBC_TIME_MIN = 0.33

// أعماق الكشف (فيبوناتشي، تبدأ 13 وأقصاها 55 — بحثياً النطاق الأمثل للهارمونيك).
// عدد الطبقات النشطة يقلّ كلما كبر الفريم (وضوح أكبر، ازدحام أقل): الفريم الصغير
// يستخدم 4 أعماق، والكبير أقل — عبر تعطيل الطبقات العليا (activeL/XL) حسب الفريم.
