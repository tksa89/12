    array.push(SPECS, PatSpec.new(name = "Bat",       on = i_Bat,       gartley = false, crabFam = false, extC = false, zoneBox = false, bLo = 0.382, bHi = 0.500, bTol = 0.05, bTolLo = 0.05, bTolHi = 0.05, cLo = C_LO,  cHi = C_HI,  bcLo = 1.618, bcHi = 2.618, cdLo = 1.000, cdHi = 1.618, dLo = 0.886, dHi = 1.000, dTol = 0.05, dPrz = 1.000))
    array.push(SPECS, PatSpec.new(name = "Alt Bat",   on = i_AltBat,    gartley = false, crabFam = false, extC = false, zoneBox = false, bLo = 0.382, bHi = 0.382, bTol = 0.03, bTolLo = 0.03, bTolHi = 0.00, cLo = C_LO,  cHi = C_HI,  bcLo = 2.000, bcHi = 3.618, cdLo = 1.618, cdHi = 1.618, dLo = 0.886, dHi = 1.130, dTol = 0.05, dPrz = 1.130))
    array.push(SPECS, PatSpec.new(name = "Butterfly", on = i_Butterfly, gartley = false, crabFam = false, extC = false, zoneBox = false, bLo = 0.786, bHi = 0.786, bTol = 0.03, bTolLo = 0.03, bTolHi = 0.03, cLo = C_LO,  cHi = C_HI,  bcLo = 1.618, bcHi = 2.240, cdLo = 1.000, cdHi = 1.270, dLo = 1.272, dHi = 1.272, dTol = 0.03, dPrz = 1.272))
    array.push(SPECS, PatSpec.new(name = "Crab",      on = i_Crab,      gartley = false, crabFam = true,  extC = false, zoneBox = true,  bLo = 0.382, bHi = 0.618, bTol = 0.04, bTolLo = 0.00, bTolHi = 0.05, cLo = C_LO,  cHi = C_HI,  bcLo = 2.618, bcHi = 3.618, cdLo = 1.000, cdHi = 1.618, dLo = 1.618, dHi = 1.902, dTol = 0.05, dPrz = 1.902))
    array.push(SPECS, PatSpec.new(name = "Deep Crab", on = i_DeepCrab,  gartley = false, crabFam = true,  extC = false, zoneBox = true,  bLo = 0.886, bHi = 0.886, bTol = 0.05, bTolLo = 0.00, bTolHi = 0.05, cLo = C_LO,  cHi = C_HI,  bcLo = 2.000, bcHi = 3.618, cdLo = 1.000, cdHi = 1.618, dLo = 1.618, dHi = 1.902, dTol = 0.05, dPrz = 1.902))
